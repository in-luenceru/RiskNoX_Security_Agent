# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Database Configuration
POSTGRES_DB=risknox_db
POSTGRES_USER=risknox_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3 Storage Configuration
S3_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY
S3_SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION
S3_BUCKET=risknox-storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application Configuration
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_IN_PRODUCTION
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
LOG_LEVEL=INFO
ENVIRONMENT=production

# Service Ports
MANAGER_PORT=8001
ADMIN_UI_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# Network Configuration
MANAGER_HOST=localhost

# Monitoring
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem